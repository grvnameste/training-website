# Session signing secret (required in production, min 32 characters)
SESSION_SECRET=change-me-to-a-long-random-string

# Scheduled notification sync (send as Authorization: Bearer <secret>)
CRON_SECRET=change-me-to-a-long-random-string

# Supabase (database + storage only — authentication is handled in-app)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PostgreSQL Database (Drizzle ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/readnrevise?schema=public"

# Brevo Email API (Optional)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_RECEIVER_EMAIL=

#USER ACCOUNT
# test_student | test_student@example.com | TestPass123! | student / student |
# test_teacher | test_teacher@example.com | TestPass123! | teacher / instructor |
# test_admin | test_admin@example.com | TestPass123! | super_admin / org_admin |